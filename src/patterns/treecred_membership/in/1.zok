import "hashes/sha256/512bitPadded" as sha256;
from "ecc/babyjubjubParams" import BabyJubJubParams;
import "signatures/verifyEddsa.code" as verifyEddsa;
import "ecc/babyjubjubParams.code" as context;
import "hashes/utils/256bitsDirectionHelper" as multiplex;

const u32 DEPTH = 3;
const u32 C_DEPTH = 3;
const u32 LEN = 1;

def select(bool condition, u32[8] left, u32[8] right) -> (u32[8], u32[8]) {
	return (condition ? right : left, condition ? left : right);
}

def check_compliance(u32[8] leaf, u32[8] root, bool[C_DEPTH] dir, u32[C_DEPTH][8] path) -> bool {
    // Check membership
    u32[8] mut digest = leaf;

    // Loop up the tree
    for u32 i in 0..C_DEPTH {
        (u32[8], u32[8]) s = select(dir[i], digest, path[i]);
        digest = sha256(s.0, s.1);
    }

    return digest == root;
}

// Merkle-Tree inclusion proof for tree depth 4 using sha256
// dir => true if current digest is on the rhs of the hash
def verify(u32[8] leaf, u32[8] c_root, bool[C_DEPTH] c_dir, u32[C_DEPTH][8] c_path, u32[8] root, bool[DEPTH] dir, u32[DEPTH][8] path) -> bool {
    // Start from the leaf
    u32[8] mut digest = leaf;

    // Loop up the tree
    for u32 i in 0..DEPTH {
        (u32[8], u32[8]) s = select(dir[i], digest, path[i]);
        digest = sha256(s.0, s.1);
    }

    bool is_member = digest == root;
    bool is_compliant = check_compliance(leaf, c_root, c_dir, c_path);

    return is_member && is_compliant;
}

def main(
    u32[LEN][8] c_roots, private bool[LEN][C_DEPTH] c_dirs, private u32[LEN][C_DEPTH][8] c_paths, private u32[LEN][8] leaves, private bool[LEN][DEPTH] dirs, private u32[LEN][DEPTH][8] paths,
    u32[8] root, private field[2] R, private field S, field[2] A, u32[8] M0, u32[8] M1
) -> bool {
    // Verify Signature (R, S) with PubKey (A) on Hash (M0, M1)
    BabyJubJubParams context = context();
    bool is_issued = verifyEddsa(R, S, A, M0, M1, context);
    u32[8] h1 = sha256([0, 0, 0, 0, 0, 0, 0, 0], root);
    bool is_hash = h1 == M0;

    bool mut is_verified = true;
    for u32 i in 0..LEN {
        is_verified = is_verified && verify(leaves[i], c_roots[i], c_dirs[i], c_paths[i], root, dirs[i], paths[i]);
    }

    return is_issued && is_hash && is_verified;
}