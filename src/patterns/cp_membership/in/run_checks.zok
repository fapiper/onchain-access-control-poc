from "../../../utils.zok" import check_keybinding, check_compliant_membership, check_authentic_cp;

const u32 DEPTH = 3;

def run_checks<N, D>(u32[N][8] membership_root, bool[N][D] membership_dir, u32[N][D][8] membership_path, u32[N][8] C0, u32[N][8] C1, u32[N][8] attr_key, u32[N][8] attr_value, field[2] R, field S, field[2] A, u32[8] N0, u32[8] N1) -> bool {
    bool is_keybinding = check_keybinding(R, S, A, N0, N1);
    bool mut success = is_keybinding;

    for u32 i in 0..N {
        bool is_authentic = check_authentic_cp(C0[i], attr_key[i], attr_value[i]);
        bool is_compliant = check_compliant_membership(attr_value[i], membership_root[i], membership_dir[i], membership_path[i]);
        success = success && is_authentic && is_compliant;
    }

    return success;
}