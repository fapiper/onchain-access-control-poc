from "./run_checks.zok" import run_checks;

const u32 N = 2;

def main(u32[N] range_min, u32[N] range_max, u32[N][8] C0, u32[N][8] C1, private u32[N][8] attr_key, private u32[N][8] attr_value, private field[2] R, private field S, private field[2] A, u32[8] N0, u32[8] N1) {
    bool success = run_checks(range_min, range_max, C0, C1, attr_key, attr_value, R, S, A, N0, N1);
    assert(success);
}