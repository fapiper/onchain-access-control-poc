from "./run_checks.zok" import run_checks;

const u32 N = 1;

def main(u32[N] range_min, u32[N] range_max, u32[N][8] h0, u32[N][8] h1, private u32[N][8] attr_key, private u32[N][8] attr_value, private field[2] R, private field S, private field[2] A, u32[8] nonce0, u32[8] nonce1) {
    bool success = run_checks(range_min, range_max, h0, h1, attr_key, attr_value, R, S, A, nonce0, nonce1);
    assert(success);
}