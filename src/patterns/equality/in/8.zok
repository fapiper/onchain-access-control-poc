import "hashes/sha256/512bitPadded" as sha256;
from "ecc/babyjubjubParams" import BabyJubJubParams;
import "signatures/verifyEddsa.code" as verifyEddsa;
import "ecc/babyjubjubParams.code" as context;

def exec(u32[8] name, u32[8] value, field[2] R, field S, field[2] A, u32[8] M0, u32[8] M1) -> bool {

    BabyJubJubParams context = context();
    bool isVerified = verifyEddsa(R, S, A, M0, M1, context);

    u32[8] h = sha256(name, value);

    bool isHash = h == M0;

    return isVerified && isHash;
}

def main(
    private u32[8] name0, private u32[8] value0, private field[2] R0, private field S0, field[2] A0, u32[8] M00, u32[8] M10,
    private u32[8] name1, private u32[8] value1, private field[2] R1, private field S1, field[2] A1, u32[8] M01, u32[8] M11,
    private u32[8] name2, private u32[8] value2, private field[2] R2, private field S2, field[2] A2, u32[8] M02, u32[8] M12,
    private u32[8] name3, private u32[8] value3, private field[2] R3, private field S3, field[2] A3, u32[8] M03, u32[8] M13,
    private u32[8] name4, private u32[8] value4, private field[2] R4, private field S4, field[2] A4, u32[8] M04, u32[8] M14,
    private u32[8] name5, private u32[8] value5, private field[2] R5, private field S5, field[2] A5, u32[8] M05, u32[8] M15,
    private u32[8] name6, private u32[8] value6, private field[2] R6, private field S6, field[2] A6, u32[8] M06, u32[8] M16,
    private u32[8] name7, private u32[8] value7, private field[2] R7, private field S7, field[2] A7, u32[8] M07, u32[8] M17
) -> bool {
    return exec(name0, value0, R0, S0, A0, M00, M10) &&
           exec(name1, value1, R1, S1, A1, M01, M11) &&
           exec(name2, value2, R2, S2, A2, M02, M12) &&
           exec(name3, value3, R3, S3, A3, M03, M13) &&
           exec(name4, value4, R4, S4, A4, M04, M14) &&
           exec(name5, value5, R5, S5, A5, M05, M15) &&
           exec(name6, value6, R6, S6, A6, M06, M16) &&
           exec(name7, value7, R7, S7, A7, M07, M17);
}