import "hashes/sha256/512bitPadded" as sha256;
from "ecc/babyjubjubParams" import BabyJubJubParams;
import "signatures/verifyEddsa.code" as verifyEddsa;
import "ecc/babyjubjubParams.code" as context;

def exec(u32 min, u32 max, u32[8] name, u32[8] value, field[2] R, field S, field[2] A, u32[8] M0, u32[8] M1) -> bool {

    BabyJubJubParams context = context();
    bool isVerified = verifyEddsa(R, S, A, M0, M1, context);

    u32[8] h = sha256(name, value);

    bool isHash = h == M0;
    bool inRange = min <= value[7] && max >= value[7];

    return isVerified && isHash && inRange;
}

def main(
    u32 min0, u32 max0, private u32[8] name0, private u32[8] value0, private field[2] R0, private field S0, field[2] A0, u32[8] M00, u32[8] M10,
    u32 min1, u32 max1, private u32[8] name1, private u32[8] value1, private field[2] R1, private field S1, field[2] A1, u32[8] M01, u32[8] M11,
    u32 min2, u32 max2, private u32[8] name2, private u32[8] value2, private field[2] R2, private field S2, field[2] A2, u32[8] M02, u32[8] M12
) -> bool {
    return exec(min0, max0, name0, value0, R0, S0, A0, M00, M10) &&
           exec(min1, max1, name1, value1, R1, S1, A1, M01, M11) &&
           exec(min2, max2, name2, value2, R2, S2, A2, M02, M12);
}
